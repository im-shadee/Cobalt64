<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cobalt64.Editor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cobalt64.Editor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cobalt64.Editor">
    
    <StackPanel Spacing="10" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="Create New Project..."
                Click="OnCreateNewProjectClicked"/>
        
        <Button Content="Open Project..."
                Click="OnOpenProjectClicked"/>
    </StackPanel>

</Window>
